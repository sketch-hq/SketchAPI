{
  "version": "2.0.0",
  "tasks": [
    //
    // Build & Lint
    //
    {
      "label": "Build & Lint",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOrder": "sequence",
      "dependsOn": ["Build", "Lint"]
    },
    {
      "label": "Build",
      "type": "npm",
      "hide": true,
      "script": "build",
      "presentation": {
        "clear": true
      }
    },
    {
      "label": "Lint",
      "type": "npm",
      "hide": true,
      "script": "lint"
    },
    //
    // Test
    //
    {
      "label": "Test",
      "dependsOrder": "sequence",
      "dependsOn": ["Build & Lint", "Test Default"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Test Default",
      "type": "npm",
      "hide": true,
      "script": "test"
    },
    //
    // Test (single test suite)
    //
    {
      "label": "Test [Single Suite]",
      "dependsOrder": "sequence",
      "dependsOn": [
        "[Show the test suite name prompt]",
        "Build & Lint",
        "Test Single Suite"
      ],
      "group": {
        "kind": "test"
      }
    },
    {
      "label": "[Show the test suite name prompt]",
      "type": "shell",
      "hide": true,
      "command": "echo",
      "options": {
        "env": {
          "TEST_SUITE": "${input:testSuite}"
        }
      }
    },
    {
      "label": "Test Single Suite",
      "type": "npm",
      "hide": true,
      "script": "test:suite",
      "options": {
        "env": {
          "TEST_SUITE": "${input:testSuite}"
        }
      }
    },
    //
    // Test (custom Sketch target)
    //
    {
      "label": "Test [Custom Sketch]",
      "dependsOrder": "sequence",
      "dependsOn": [
        "[Show target Sketch variant prompt]",
        "Build & Lint",
        "Test Sketch Variant"
      ],
      "group": {
        "kind": "test"
      }
    },
    {
      "label": "[Show target Sketch variant prompt]",
      "type": "shell",
      "hide": true,
      "command": "echo",
      "options": {
        "env": {
          "SKETCH_VARIANT_BUNDLE_ID": "${input:sketchTarget}"
        }
      }
    },
    {
      "label": "Test Sketch Variant",
      "type": "npm",
      "script": "test:custom",
      "hide": true,
      "options": {
        "env": {
          "SKETCH_VARIANT_BUNDLE_ID": "${input:sketchTarget}"
        }
      }
    }
  ],
  //
  // [INPUTS]
  //
  "inputs": [
    {
      "id": "sketchTarget",
      "description": "Choose the target Sketch variant",
      "type": "pickString",
      "options": [
        "com.bohemiancoding.sketch3.xcode",
        "com.bohemiancoding.sketch3.beta",
        "com.bohemiancoding.sketch3"
      ],
      "default": "com.bohemiancoding.sketch3.xcode"
    },
    {
      "id": "testSuite",
      "description": "Enter the test suite name:",
      "type": "promptString",
      "default": ""
    }
  ]
}
